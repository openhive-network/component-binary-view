{
  "name": "binary-view-presentation",
  "description": "Binary view representation of the transaction",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist-wc/binary-view.js",
    "dist-wc/binary-view.umd.cjs"
  ],
  "main": "./dist-wc/binary-view.umd.cjs",
  "module": "./dist-wc/binary-view.js",
  "exports": {
    ".": {
      "import": "./dist-wc/binary-view.js",
      "require": "./dist-wc/binary-view.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" \"build-ce {@}\" --",
    "build-only": "vite build",
    "build-ce": "vite build -c vite.config.ce.ts --outDir dist-wc",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@hiveio/wax": "1.27.6-rc5-241016111634",
    "@mdi/font": "7.4.47",
