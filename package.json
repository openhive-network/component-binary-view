{
  "name": "@hiveio/component-binary-view",
  "description": "Binary view representation of the transaction",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Hive Community",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-*",
    "build-only": "vite build",
    "build-ce": "vite build -c web-component/vite.config.ts --outDir dist-wc",
    "build-vue": "vite build -c vue-component/vite.config.ts --outDir dist-vue",
    "prepack": "run-p prepack-*",
    "prepack-ce": "tsx render-package.ts web-component dist-wc",
    "prepack-vue": "tsx render-package.ts vue-component dist-vue",
    "pack": "cd dist-wc && npm pack && cd ../dist-vue && npm pack",
    "publish": "sh publish-packages.sh dist-wc dist-vue",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@hiveio/wax": "catalog:hiveio-toolset",
    "@mdi/font": "7.4.47",
    "@mdi/js": "^7.4.47",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tailwindcss/postcss": "catalog:tailwind-toolset",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "eta": "^3.5.0",
    "lucide-vue-next": "^0.453.0",
    "npm-run-all2": "^6.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "radix-vue": "^1.9.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "catalog:tailwind-toolset",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "catalog:typescript-toolset",
    "typescript": "catalog:typescript-toolset",
    "vite": "^5.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "catalog:vue-toolset",
    "vue-web-component-wrapper": "^1.6.7",
    "vuetify": "catalog:vue-toolset"
  },
  "dependencies": {
    "pinia": "catalog:vue-toolset",
    "vue": "catalog:vue-toolset"
  }
}
